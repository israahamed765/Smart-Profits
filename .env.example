DATABASE_URL=postgresql://smartprofit:smartprofit@localhost:5432/smartprofit

# Nokia Network-as-Code (RapidAPI). Get the key from networkascode.nokia.io → profile → dashboard → console → applications.
# When set: Smart Guard uses live Nokia/RapidAPI via server/smart-guard/nokia-adapter.ts (passthrough CAMARA paths).
# When empty: local nokia-mock simulator only — /api/nac/* demo routes always stay on the local catalog.
# Step-up demoCode is shown in NODE_ENV=development even with NAC_API_KEY (hackathon local demo); never in production.
# Official test MSISDNs (+99999991000 swap, +99999991001 clean, +99999991002 location PARTIAL) come from Nokia docs — never hardcoded in policy.
NAC_API_KEY=
NAC_RAPIDAPI_HOST=network-as-code.nokia.rapidapi.com
NAC_BASE_URL=https://network-as-code.p-eu.rapidapi.com

# Optional: Number Verification OIDC (live operator flows only — never commit secrets).
# NAC_NV_OIDC_CLIENT_ID=
# NAC_NV_OIDC_CLIENT_SECRET=

APP_URL=http://localhost:3000
# Explicit UI origin for backend CORS + CSRF (never *). Comma-separated if needed.
FRONTEND_ORIGIN=http://localhost:3000
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_APP_PASSWORD=

# Server secrets — required. Never put these in frontend code or commit real values.
SESSION_SECRET=generate-a-long-random-string
ADMIN_EMAIL=admin@smartprofits.com
ADMIN_PASSWORD=set-a-strong-admin-password
ADMIN_NAME=مديرة Smart Profits

# Optional P12.2 standalone backend (server-only). Never put secrets in NEXT_PUBLIC_*.
# BACKEND_PORT=4000
# Same host as the UI (`localhost`) so host-only cookies are sent. Do not use 127.0.0.1
# for browser calls from http://localhost:3000 — that is a different cookie host.
# BACKEND_HOST=localhost
# Next.js BFF proxy (server-only). Browser still talks to Next /api/*; cookies stay on the UI origin.
# BACKEND_URL=http://localhost:4000

# Public API origin for the browser client only when calling the backend directly.
# Empty (default) keeps same-origin /api/* on Next.js. Not a secret.
# NEXT_PUBLIC_API_BASE_URL=
