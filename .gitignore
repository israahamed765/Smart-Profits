# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local user store (passwords + per-account workspaces)
/data/users.json
/data/workspaces/
/data/events.json
/data/nac-demo.json
/data/guard-decisions.json

# P14.11 / P14.12R frozen snapshots (contain password hashes) and write-freeze flag
/.p14.11-snapshot/
/.p14.12r-snapshot/
/.p14.13-snapshot/
/.p14.13-reconcile/
/.p14.14r-snapshot/
/.p14.14r-reconcile/
/.p14.15-pre-cutover-snapshot/
/.p14.15-pre-cutover-reconcile/
/data/.p14.12r-write-freeze
/data/.p14.15-pg-primary-cutover
/data/.p14.16-shadow-validation
/data/.p14.17-json-shadow-removed
/.p14.17-json-archive/


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
